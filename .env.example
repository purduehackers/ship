# Turso (libsql)
TURSO_DATABASE_URL="libsql://db-name-user.turso.io"
TURSO_AUTH_TOKEN=""

# Vercel Blob (auto-set when the project is connected to a Blob store)
BLOB_READ_WRITE_TOKEN=""

# Incoming API auth — ships-write API (bot uses this)
SHIP_API_KEY=""

# Optional: resolve mentions not already named in the public ships feed
DISCORD_BOT_TOKEN=""

# Privacy service (outbound) — used by getUserModes
PRIVACYDB_URL=""
PRIVACYDB_API_KEY=""

# ISR (on-demand revalidation)
ISR_BYPASS_TOKEN=""
